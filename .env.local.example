# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — do NOT commit it. Each developer maintains their own.
# See README for setup notes.

# Base URL of the ShopBot Express API (server-side only; never exposed to the browser).
SHOPBOT_API=http://localhost:4100

# Slug identifying which ShopBot store this deployment scopes to. Public — surfaced to the client.
NEXT_PUBLIC_STORE_SLUG=roadsters

# Name of the HttpOnly cookie that holds the ShopBot JWT after admin login.
JWT_COOKIE_NAME=shopbot_jwt
